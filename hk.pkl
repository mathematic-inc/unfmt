amends ".hk/org.pkl"

steps {
  ["cargo-lockfile"] {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = List("slow")
  }
  // The builtin `dir` is `{{workspace}}`, which hk does not define without `workspace_indicator`.
  ["cargo-deny"] { dir = "{{root}}" }
}
