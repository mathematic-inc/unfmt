amends ".hk/org.pkl"

steps {
  ["cargo-lockfile"] {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = List("slow")
  }
  // The step of the organization sets no `workspace_indicator`, so hk cannot render the `dir`
  // of the builtin step.
  ["cargo-deny"] { dir = "{{root}}" }
}
